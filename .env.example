# Copy to .env.local and fill in. Never commit .env.local.

# --- Google Earth Engine (required for all analysis routes) ---
# Service account JSON key, base64-encoded.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   bash:       base64 -w0 key.json
GEE_SERVICE_ACCOUNT_KEY_B64=
# Google Cloud project ID registered for Earth Engine (noncommercial).
GEE_PROJECT_ID=

# --- Earth Engine ML assets (set after `pnpm ml:train`, phase 3) ---
# Asset ID of the saved Random Forest classifier, e.g. projects/<project>/assets/groundtruth_rf_v1
GEE_CLASSIFIER_ASSET=

# --- LLM summary (optional; template summary is used when unset) ---
ANTHROPIC_API_KEY=
# Override the model used for summaries (default is set in code).
ANTHROPIC_MODEL=

# --- Geocoding (Nominatim) ---
# Contact string put in the User-Agent, per the Nominatim usage policy.
# Use an app URL or a contact address you are happy to expose publicly.
NOMINATIM_CONTACT=

# --- Analysis defaults (optional) ---
# Zone radius in metres (default 150)
ZONE_RADIUS_M=150
# Season window as month numbers, inclusive (default 1-3 = Jan..Mar, post-monsoon dry season)
SEASON_START_MONTH=1
SEASON_END_MONTH=3

# --- Playwright / tests ---
# Base URL for e2e tests (default http://localhost:3000)
E2E_BASE_URL=
